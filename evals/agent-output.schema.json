{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe Coding Live Agent Behavior Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "tier",
    "approval_required",
    "controls",
    "forbidden_actions"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "approval_required": {
      "type": "boolean"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
