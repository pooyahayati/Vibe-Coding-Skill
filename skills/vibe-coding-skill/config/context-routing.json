  "interaction_rules": [
    {
      "when_all": [
        "woocommerce",
        "payments"
      ],
      "add_packs": [
        "security-web",
        "external-http",
        "performance-web"
      ],
      "minimum_tier": 3,
      "reason": "payment/order-state interaction is financially sensitive and crosses remote/state boundaries",
      "skip_if_task_matches": [
        "label",
        "copy",
        "text only",
        "typo",
        "styling",
        "css only",
        "rename"
      ]
    },
    {
      "when_all": [
        "wordpress-rest",
        "external-http"
      ],
      "add_packs": [
        "security-web",
        "performance-web"
      ],
      "minimum_tier": 2,
      "reason": "REST plus remote integration adds authorization, latency, and failure-mode concerns"
    },
    {
      "when_all": [
        "payments",
        "external-http"
      ],
      "add_packs": [
        "security-web",
        "performance-web"
      ],
      "minimum_tier": 3,
      "reason": "remote payment operations require idempotency, authorization, failure handling, and latency control",
      "skip_if_task_matches": [
        "label",
        "copy",
        "text only",
        "typo",
        "styling",
        "css only",
        "rename"
      ]
    },
    {
      "when_all": [
        "wordpress-rest"
      ],
      "add_packs": [
        "security-web"
      ],
      "minimum_tier": 1,
      "reason": "REST routes require explicit permission and input/output security review; mutation/auth/external concerns raise risk separately"
    }
  ]
}
